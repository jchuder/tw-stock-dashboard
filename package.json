{
  "name": "tw-stock-dashboard",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm verify:boundaries",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r --parallel test",
    "test:e2e": "pnpm build && playwright test",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "dev:api": "pnpm --filter @tw-stock-dashboard/api dev",
    "dev:web": "pnpm --filter @tw-stock-dashboard/web dev",
    "dev:web:tunnel": "pnpm --filter @tw-stock-dashboard/web dev:tunnel",
    "smoke:dev-topology": "node scripts/smoke-dev-topology.mjs",
    "commitlint": "commitlint",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "release:tags": "changeset git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "lefthook": "2.1.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
