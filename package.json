{
  "name": "tw-stock-dashboard",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm verify:boundaries",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r --parallel test",
    "test:e2e": "pnpm build && playwright test",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "dev:api": "pnpm --filter @tw-stock-dashboard/api dev",
    "dev:web": "pnpm --filter @tw-stock-dashboard/web dev",
    "smoke:dev-topology": "node scripts/smoke-dev-topology.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
