# Fugle Market Data API Key（個股報價與歷史走勢必要設定；API 服務未內建 dotenv，請透過 shell export 或啟動前帶入）
# 個股報價（Quote）：Fugle primary，遇短暫服務異常時自動降級至 TWSE MIS fallback；若未設定 key 則直接回傳錯誤不降級
# 歷史資料（History）：僅支援 Fugle；若未設定 key 則直接回傳錯誤
FUGLE_API_KEY=your_fugle_api_key_here

# OpenTelemetry 與 SigNoz 配置（選填）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENV=development
OTEL_SERVICE_NAME=tw-stock-dashboard-api

# API 服務連接埠（預設 3001）
PORT=3001

# 日誌層級（debug, info, warn, error，預設 info）
LOG_LEVEL=info
