# Fugle Market Data API Key（選填，未設定時將自動 fallback 至公開 TWSE/TPEx 管道）
FUGLE_API_KEY=your_fugle_api_key_here

# OpenTelemetry 與 SigNoz 配置（選填）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENV=development
OTEL_SERVICE_NAME=tw-stock-dashboard-api

# API 服務連接埠（預設 3001）
PORT=3001

# 日誌層級（debug, info, warn, error，預設 info）
LOG_LEVEL=info
