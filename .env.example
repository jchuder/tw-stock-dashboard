# Fugle Market Data API Key（選填）
# 留空即啟用「公開資料模式」（Public Data Mode）：個股報價自動使用 TWSE MIS，日 K 與指標分析使用 TWSE / TPEx 官方資料；盤中 5 分 K 停用並提示
# 設定有效 Key 則啟用「Enhanced Mode」：提供盤中 5 分 K 與即時行情
FUGLE_API_KEY=

# OpenTelemetry 與 SigNoz 設定（選填）
# Native 模式：localhost 指主機；若本機沒有 collector 請留空。
# Docker Compose：不要直接沿用 native 的 localhost endpoint；請改用容器可達的位址。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENV=development
OTEL_SERVICE_NAME=tw-stock-dashboard-api

# Native local Redis（選填）；Docker Compose 會改用 `redis://redis:6379`
REDIS_URL=

# API port（預設 3001）
PORT=3001

# 日誌層級（debug, info, warn, error，預設 info）
LOG_LEVEL=info
