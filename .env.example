# Fugle Market Data API Key（選填）
# 留空即啟用「公開資料模式」（Public Data Mode）：個股報價自動使用 TWSE MIS，日 K 與指標分析使用 TWSE / TPEx 官方資料；盤中 5 分 K 停用並提示
# 設定有效 Key 則啟用「Enhanced Mode」：提供盤中 5 分 K 與即時行情
FUGLE_API_KEY=

# OpenTelemetry 與 SigNoz 配置（選填）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENV=development
OTEL_SERVICE_NAME=tw-stock-dashboard-api

# API 服務連接埠（預設 3001）
PORT=3001

# 日誌層級（debug, info, warn, error，預設 info）
LOG_LEVEL=info
