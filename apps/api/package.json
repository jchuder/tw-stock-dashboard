{
  "name": "@tw-stock-dashboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "node --env-file-if-exists=.env.local ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start": "node --env-file-if-exists=.env.local dist/main.js",
    "start:otel": "node --env-file-if-exists=.env.local --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./otel-register.mjs dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@tw-stock-dashboard/contracts": "workspace:*",
    "effect": "3.22.1",
    "nestjs-pino": "5.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/node": "^24.13.3",
    "@types/supertest": "^2.0.16",
    "supertest": "^7.1.4",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
